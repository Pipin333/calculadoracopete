{
  "rules": {
    "presupuestos": {
      "$presupuestoId": {
        ".read": "true",
        ".write": "auth != null",
        ".validate": "$presupuestoId.matches(/^[a-zA-Z0-9]{6,8}$/) && newData.hasChildren(['data', 'createdAt'])",
        "data": {
          ".validate": "newData.exists() && newData.hasChildren(['personas', 'aporte', 'modo', 'bebidas'])"
        },
        "createdAt": {
          ".validate": "newData.isString()"
        },
        "expiresAt": {
          ".validate": "newData.isString()"
        },
        "viewCount": {
          ".validate": "newData.isNumber() || !newData.exists()"
        }
      }
    },

    "admin_prices": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "root.child('admins').child(auth.uid).val() === true",
      "$productId": {
        ".validate": "newData.exists() && newData.hasChildren(['nombre', 'categoria', 'prices'])"
      }
    },

    "sku_status": {
      ".read": "true",
      ".write": "root.child('admins').child(auth.uid).val() === true",
      "$skuKey": {
        ".validate": "newData.hasChild('active')"
      }
    },

    "admins": {
      ".read": "auth != null",
      ".write": "false"
    },

    "users": {
      "$uid": {
        ".read": "auth.uid == $uid",
        ".write": "auth.uid == $uid && !newData.hasChild('isAdmin')",
        "email": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isString()"
        }
      }
    },

    "events": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null",
      "$eventId": {
        ".validate": "newData.exists() && newData.hasChildren(['type', 'timestamp'])"
      }
    }
  }
}
